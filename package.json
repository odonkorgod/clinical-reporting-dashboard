{
  "name": "clinflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clinflow/backend db:generate && pnpm --parallel --filter @clinflow/backend --filter @clinflow/frontend dev",
    "build": "pnpm --filter @clinflow/backend build && pnpm --filter @clinflow/frontend build",
    "start": "pnpm --filter @clinflow/backend start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @clinflow/backend typecheck && pnpm --filter @clinflow/frontend typecheck",
    "generate:data": "pnpm --filter @clinflow/backend generate:data",
    "db:migrate": "pnpm --filter @clinflow/backend db:migrate",
    "db:seed": "pnpm --filter @clinflow/backend db:seed"
  },
  "dependencies": {
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
