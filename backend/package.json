{
  "name": "@clinflow/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "generate:data": "tsx scripts/generate-seed-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clinflow/shared": "workspace:*",
    "@types/node": "^24.12.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
